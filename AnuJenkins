pipeline {
    agent any

    stages {
        stage('checkout') {
            steps {
               git branch: 'main', url: 'https://github.com/sarangi99/CICD.git'

            }
        }

        stage('Compile') {
            steps {
                sh 'mvn clean compile'
            }
        }
       stage('Test') {
            steps {
                sh 'mvn test'
            }
        }
      stage('Package appliaction') {
            steps {
                sh 'mvn package'
            }
        }
        stage('Deploy') {
            steps {
                sh 'cp /var/lib/jenkins/workspace/pipeline01/target/java-war-website.war /home/ubuntu/tomcat/webapps'
            }
        }
    }
}
